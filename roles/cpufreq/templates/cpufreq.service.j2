[Unit]
Description=Configure CPUFreq
After=multi-user.target

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/bin/sleep 60
ExecStart=/bin/sh -c 'echo {{ cpufreq_scaling_governor }} | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null'

[Install]
WantedBy=multi-user.target
