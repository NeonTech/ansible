[Unit]
Description=Fluxcord
After=network.target

[Service]
Type=simple
User={{ fluxcord_user_name }}
Group={{ fluxcord_group_name }}
WorkingDirectory=/etc/fluxcord
ExecStartPre=/etc/fluxcord/node_modules/.bin/tsx ./migrate.ts
ExecStart=/usr/local/bin/node ./index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
